# PostgreSQL (el profesor se conecta con psql -U admin -d spotify)
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=spotify

# Kafka: tópico donde la app publica las reproducciones
KAFKA_TOPIC=streams

# Simulador de la app (app_simulator/producer.py)
INTERVAL_SECONDS=2
SKIP_RATE=0.3
DUPLICATE_RATE=0.2
MAX_DUPLICATE_DELAY_SECONDS=300
MAX_PLAY_AGE_DAYS=14
